# Leave blank to run the functional, offline knowledge-based DEMO mode.
# For the actual LLM assessment, create a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional: set to demo to deliberately bypass the AI API even when a key is set.
AI_MODE=auto
# Optional: cap requests per client IP in a rolling 60-second window.
REQUESTS_PER_MINUTE=25
